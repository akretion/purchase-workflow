<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button
                    name="%(action_view_account_voucher_wizard)d"
                    string="Pay purchase advanced"
                    type="action"
                    groups="account.group_account_invoice"
                    attrs="{'invisible': ['|',('state', 'in', ['done','cancel']),('invoice_status', 'in', ['invoiced'])]}"
                />
            </button>
            <notebook position="inside">
                <page string="Payment advances" groups="account.group_account_invoice">
                    <group>
                        <field
                            name="account_payment_ids"
                            nolabel="1"
                            colspan="4"
                            context="{'form_view_ref': 'account.view_account_payment_form','tree_view_ref': 'purchase_advance_payment.view_purchase_advance_payment_tree'}"
                        />
                        <separator />
                        <group>
                            <!-- I know that it's not a good practice to display the same field twice in the same view,
                            but it seems mandatory to have the residual amounts visible from the payments notebook -->
                            <div class="oe_inline text-right">
                                <label for="residual_draft" />
                                <span>: </span>
                                <field
                                    name="residual_draft"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}"
                                />
                                <label for="residual_posted" class="ml-3 font-weight-bold"/>
                                <span>: </span>
                                <field
                                    name="residual_posted"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}"
                                    class="font-weight-bold"
                                />
                            </div>
                      </group>
                  </group>
                </page>
            </notebook>

            <xpath expr="//field[@name='amount_total']" position="attributes">
                <attribute name="class">mb-3 oe_subtotal_footer_separator</attribute>
            </xpath>

            <xpath expr="//field[@name='amount_total']" position="after">
                <field
                    name="residual_draft"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                />
                <div class="oe_inline oe_subtotal_footer_separator">
                    <label for="residual_posted" />
                </div>
                <field
                    name="residual_posted"
                    nolabel="1"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                    class="oe_subtotal_footer_separator"
                />
            </xpath>

        </field>
    </record>

    <record id="purchase_order_view_tree" model="ir.ui.view">
        <field name="name">purchase.order.view.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <field name="invoice_status" position="before">
                <field
                    name="advance_payment_status"
                    decoration-success="advance_payment_status == 'paid'"
                    decoration-info="advance_payment_status == 'partial'"
                    decoration-warning="advance_payment_status == 'not_paid'"
                    widget="badge"
                    optional="hide"
                />
            </field>
            <field name="amount_total" position="after">
                <field
                    name="residual_posted"
                    sum="Amount Residual"
                    widget="monetary"
                    decoration-bf="1"
                    optional="hide"
                />
            </field>
        </field>
    </record>
</odoo>
