<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_bill_matching" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.bill.matching</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                 <button class="oe_stat_button"
                         name="action_bill_matching"
                         type="object"
                         groups="account.group_account_invoice"
                         icon="fa-bullseye"
                         attrs="{'invisible': [('state', 'not in', ('purchase', 'done'))]}">
                     <div class="o_field_statinfo">
                         <span class="o_stat_text">Bill Matching</span>
                     </div>
                 </button>
            </div>
        </field>
    </record>
</odoo>
