<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_purchase_bill_matching" model="ir.ui.view">
        <field name="name">account.move.inherit.purchase.bill.matching</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="purchase.view_move_form_inherit_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        name="action_purchase_matching"
                        type="object"
                        groups="purchase.group_purchase_user"
                        icon="fa-bullseye"
                        attrs="{'invisible': ['|', '|', ('partner_id', '=', False), ('move_type', 'not in', ('in_invoice', 'in_refund')), ('is_purchase_matched', '=', True)]}">
                    <div class="o_field_statinfo">
                        <span class="o_stat_text">Purchase Matching</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
