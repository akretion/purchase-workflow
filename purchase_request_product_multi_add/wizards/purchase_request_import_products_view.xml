<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_import_product_to_purchase_request" model="ir.ui.view">
        <field name="name">import.products.to.purchase.request.form</field>
        <field name="model">purchase.request.import.products</field>
        <field name="arch" type="xml">
            <form string="Products">
                <field name="products" />
                <footer>
                    <button name="create_items" string="Import" type="object" class="oe_highlight" />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="view_edit_new_purchase_request_lines" model="ir.ui.view">
        <field name="name">import.products.to.purchase.request.line.tree</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <tree create="0" editable="bottom" multi_edit="1">
                <field name="product_id" readonly="1" />
                <field name="product_qty" />
                <field name="date_required" />
                <field name="estimated_cost" />
            </tree>
        </field>
    </record>
    <record id="action_import_product_to_purchase_request" model="ir.actions.act_window">
        <field name="name">Import Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.import.products</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_import_product_to_purchase_request" />
        <field name="target">new</field>
        <field name="context">{'default_request_id': active_id}</field>
    </record>
</odoo>
