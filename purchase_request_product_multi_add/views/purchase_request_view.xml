<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_request_product_multi_add" model="ir.ui.view">
        <field name="name">purchase.request.product.multi.add</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <notebook position="before">
                <button name="%(action_import_product_to_purchase_request)d" class="btn-primary" style="margin:12px 0px 12px 0px;" string="Add multiple products" icon="fa-plus-circle" Help="Select Products to Import" type="action" />
                <!-- attrs="{'invisible':[('state','not in', ['draft', 'sent'])]}"  -->
            </notebook>
            <field name="line_ids" position="attributes">
                <attribute translation="off" name="options">{'always_reload':true}</attribute>
            </field>
        </field>
    </record>
</odoo>
