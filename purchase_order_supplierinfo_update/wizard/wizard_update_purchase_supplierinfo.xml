<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_wizard_update_purchase_supplierinfo_form" model="ir.ui.view">
        <field name="model">wizard.update.purchase.supplierinfo</field>
        <field name="arch" type="xml">
            <form>
                <group col="4" colspan="4">
                    <field name="purchase_id" invisible="1" />
                    <field name="state" invisible="1" />
                </group>
                <separator string="List of products to update" />
                <field name="line_ids">
                    <tree
                        create="false"
                        editable="bottom"
                        decoration-info="not supplierinfo_id"
                    >
                        <field name="product_id" />
                        <field name="supplierinfo_id" />
                        <field
                            name="current_price"
                            attrs="{'invisible': [('supplierinfo_id', '=', 'False')]}"
                            optional="show"
                        />
                        <field name="new_price" optional="show" />
                    </tree>
                </field>
                <footer>
                    <button
                        name="update_supplierinfo"
                        string="Update"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
